build/
*.gba
*.sav

# Graphics generated from a cartridge dump by tools/extract_assets.py: tiles,
# palettes and the screen layout. These are the original game's artwork, so
# they are built locally from a dump you supply rather than committed here.
# Run: make assets ROM=/path/to/tetris.nes
gba/tiles_*.h
gba/screen_*.h
gba/palettes_rom.h
gba/dancer_poses.h
__pycache__/
gba/audio_prg.h
gba/audio_golden.bin
# The publisher's logo for the splash screen, from an image you supply:
#   python3 tools/make_splash.py logo.png
gba/splash_logo.h
# The Game Boy Player's logo (Nintendo's), from a picture you supply:
#   python3 tools/make_gbp_logo.py gbp_logo.png
gba/gbp_logo.h
